<%
/**
 * ====================================================================================
 * TEMPLATE: Component Model
 * ====================================================================================
 *
 * PURPOSE: Generates class files for Newgrounds.io component methods.
 *
 * WHAT ARE COMPONENTS?: Components are API methods you can call, organized by category:
 * - App.checkSession: Validates the current user session
 * - Medal.unlock: Unlocks an achievement for the user
 * - ScoreBoard.postScore: Posts a score to a leaderboard
 * - CloudSave.loadSlot: Loads saved game data from the cloud
 *
 * AVAILABLE VARIABLES:
 * - model: Object containing all properties and metadata for this component method
 * - model.component: The component namespace (e.g., "Medal", "App", "ScoreBoard")
 * - model.method: The method name (e.g., "unlock", "checkSession", "postScore")
 * - model.description: Human-readable description of what this method does
 * - model.properties: Object containing all parameters this method accepts
 * - model.secure: Boolean - if true, this must be encrypted to prevent cheating
 * - model.require_session: Boolean - if true, requires a logged-in user
 * - model.redirect: Boolean - if true, opens in new tab and redirects
 * - helpers: Your custom helper methods (from helpers.js)
 * - partial: Methods to include partial templates (partial.get, partial.getIfExists)
 * - config: Your full config object with all settings
 *
 * EJS DOCUMENTATION: https://ejs.co/
 *
 * ====================================================================================
 */

// COMMENT: Prepare data structures we'll need while generating this class
// NOTE: Filter out 'error' because it's inherited from BaseObject. Also filter out
// 'redirect' -- BaseComponent already declares it, and re-declaring would shadow the
// inherited member that Core.executeComponent() reads to decide how to send the request.
const propertyNames = model.properties
    ? Object.keys(model.properties).filter(prop => prop !== 'error' && prop !== 'redirect')
    : [];
const requiredParams = propertyNames.filter(name => model.properties[name].required);
const hasProperties = propertyNames.length > 0;

// The full component path. This is the objectName, and it is what Execute.setComponent()
// writes into the wire payload -- "Medal.unlock", never just "unlock".
const componentPath = `${model.component}.${model.method}`;

// castTypes is fully derivable from the schema -- never hand-maintain it.
const castTypes = helpers.getCastTypes(model.properties, propertyNames);

// See object.ejs for why a model may need to override requiredProperties.
const requiredOverride = partial.getIfExists(`components/${model.component}/${model.method}/required_properties`);
const hasRequiredOverride = requiredOverride && requiredOverride.trim().length > 0;
-%>

COMMENT: ====================================================================================
COMMENT: IMPORTS / DEPENDENCIES
COMMENT: ====================================================================================
<%# Include any imports needed for this component. -%>
<%# Use partials to add component-specific imports. Example partial path for Medal.unlock: -%>
<%# {partials_dir}/components/Medal/unlock/imports.ejs -%>
<%- partial.getIfExists(`components/${model.component}/${model.method}/imports`) -%>

COMMENT: ====================================================================================
COMMENT: CLASS DEFINITION
COMMENT: ====================================================================================
<%- helpers.formatMultilineComment(model.description, "") %>
CLASS <%- model.method %>
    EXTENDS: BaseComponent
    NAMESPACE: [Your namespace here, e.g., io.newgrounds.models.components.<%- model.component %>]

    PURPOSE: <%- model.description %>

    COMMENT: ====================================================================================
    COMMENT: PROPERTIES
    COMMENT: ====================================================================================
    COMMENT: Plain public fields, one per component parameter. Do NOT generate
    COMMENT: getter/setter pairs -- importFromObject() assigns them by name.

<% if (hasProperties) { -%>
<%   for (let propertyName of propertyNames) { -%>
    COMMENT: <%- model.properties[propertyName].description %>
    PUBLIC <%- propertyName %>: <%- helpers.getDataType(model.properties[propertyName]) %> = <%- helpers.getDefaultValue(model.properties[propertyName]) %>

<%   } -%>
<% } -%>
<%- partial.getIfExists(`components/${model.component}/${model.method}/properties`) -%>

    COMMENT: ====================================================================================
    COMMENT: CONSTRUCTOR
    COMMENT: ====================================================================================

    CONSTRUCTOR()

        PURPOSE: Create an empty instance and declare how this component must be sent.

        COMMENT: Takes NO arguments -- see object.ejs for why the factory imports
        COMMENT: data only after assigning `core`.

        BEHAVIOR:
            COMMENT: Call the parent BaseComponent constructor
            CALL super()

            COMMENT: These three flags are inherited from BaseComponent and are assigned
            COMMENT: here rather than declared as new fields. Re-declaring them would
            COMMENT: shadow the inherited members that Core and the request helper read.
            COMMENT:
            COMMENT: isSecure        - request must be encrypted before sending
            COMMENT: requiresSession - the gateway rejects this without a valid session
            COMMENT: redirect        - open in a browser window instead of sending in the
            COMMENT:                   background; the response is never returned
            SET this.isSecure TO <%= model.secure ? "true" : "false" %>
            SET this.requiresSession TO <%= model.require_session ? "true" : "false" %>
            SET this.redirect TO <%= model.redirect ? "true" : "false" %>
<%- partial.getIfExists(`components/${model.component}/${model.method}/constructor`) -%>
    END CONSTRUCTOR

    COMMENT: ====================================================================================
    COMMENT: ABSTRACT PROPERTY OVERRIDES
    COMMENT: ====================================================================================
    COMMENT: BaseObject declares these as abstract and throws if they are not overridden.

    GETTER objectName(): string
        PURPOSE: Identifies this component for the wire format and for debugging
        COMMENT: This is the FULL component path. Execute.setComponent() copies it
        COMMENT: straight into the request, so returning only the method name would
        COMMENT: produce a request the gateway cannot route.
        RETURN "<%- componentPath %>"
    END GETTER

    GETTER objectType(): string
        PURPOSE: Categorises this model as a component (vs. an object or a result)
        RETURN "component"
    END GETTER

    GETTER propertyNames(): array<string>
        PURPOSE: Lists every parameter this component accepts
        COMMENT: Drives toObject(), so this list defines exactly what is sent as the
        COMMENT: component's parameters. Control fields must not appear here.
        RETURN <%- JSON.stringify(propertyNames) %>
    END GETTER

    GETTER requiredProperties(): array<string>
        PURPOSE: Lists parameters that must be set before this component can be sent
<% if (hasRequiredOverride) { -%>
<%- requiredOverride -%>
<% } else { -%>
        RETURN <%- JSON.stringify(requiredParams) %>
<% } -%>
    END GETTER

    GETTER castTypes(): map<string, string>
        PURPOSE: Tells importFromObject() how to convert raw values into typed models
        COMMENT: Generated from the schema. Values are SCHEMA names, because the object
        COMMENT: factory keys on schema names -- "Error", not "NgioError".
<% if (Object.keys(castTypes).length === 0) { -%>
        RETURN {}
<% } else { -%>
        RETURN {
<%   const castEntries = Object.entries(castTypes); -%>
<%   castEntries.forEach(function(entry, i) { -%>
            "<%- entry[0] %>": "<%- entry[1] %>"<%- i < castEntries.length - 1 ? "," : "" %>
<%   }); -%>
        }
<% } -%>
    END GETTER

    COMMENT: ====================================================================================
    COMMENT: CUSTOM METHODS
    COMMENT: ====================================================================================
<%# Add component-specific methods using partials -%>
<%# Example: {partials_dir}/components/Medal/unlock/methods.ejs -%>
<%- partial.getIfExists(`components/${model.component}/${model.method}/methods`) -%>

END CLASS
