<%
/**
 * ====================================================================================
 * TEMPLATE: Object Model
 * ====================================================================================
 *
 * PURPOSE: Generates class files for core Newgrounds.io object models.
 *
 * WHAT ARE OBJECTS?: Objects represent data structures returned by the API, such as:
 * - Medal: Represents an achievement/trophy
 * - User: Represents a Newgrounds user
 * - Score: Represents a scoreboard entry
 * - SaveSlot: Represents a cloud save slot
 *
 * AVAILABLE VARIABLES:
 * - model: Object containing all properties and metadata for this object
 * - model.name: The name of the object (e.g., "Medal", "User")
 * - model.description: Human-readable description of what this object represents
 * - model.properties: Object containing all properties this object has
 * - helpers: Your custom helper methods (from helpers.js)
 * - partial: Methods to include partial templates (partial.get, partial.getIfExists)
 * - config: Your full config object with all settings
 *
 * EJS DOCUMENTATION: https://ejs.co/
 *
 * ====================================================================================
 */

// COMMENT: Prepare data structures we'll need while generating this class
// NOTE: Filter out 'error' because it's inherited from BaseObject. Emitting it again
// would shadow the inherited member and round-trip a control field into toObject().
const propertyNames = Object.keys(model.properties).filter(prop => prop !== 'error');
const requiredParams = propertyNames.filter(name => model.properties[name].required);
const hasProperties = propertyNames.length > 0;

// The class name and the objectName are NOT always the same. Some schema names collide
// with native types ("Error"), so getClassName() maps them ("NgioError") -- but the
// objectName below, and the object factory's lookup keys, must stay the SCHEMA name.
const className = helpers.getClassName(model.name);

// castTypes is fully derivable from the schema -- never hand-maintain it.
const castTypes = helpers.getCastTypes(model.properties, propertyNames);

// A model may replace the schema-derived requiredProperties body with its own.
// requiredProperties can only express "all of these must be present". Models whose schema
// marks properties required under conditions the generator cannot see (mutually exclusive
// fields, for example) need to opt out and enforce the real rule in hasValidProperties().
const requiredOverride = partial.getIfExists(`objects/${model.name}/required_properties`);
const hasRequiredOverride = requiredOverride && requiredOverride.trim().length > 0;
%>

COMMENT: ====================================================================================
COMMENT: IMPORTS / DEPENDENCIES
COMMENT: ====================================================================================
<%# Include any imports needed for this object type. -%>
<%# Use partials to add object-specific imports. Example partial path for Medal object: -%>
<%# {partials_dir}/objects/Medal/imports.ejs -%>
<%- partial.getIfExists(`objects/${model.name}/imports`) -%>

COMMENT: ====================================================================================
COMMENT: CLASS DEFINITION
COMMENT: ====================================================================================
<%- helpers.formatMultilineComment(model.description, "") %>
CLASS <%- className %>
    EXTENDS: BaseObject
    NAMESPACE: [Your namespace here, e.g., io.newgrounds.models.objects]

    PURPOSE: <%- model.description %>

    COMMENT: ====================================================================================
    COMMENT: PROPERTIES
    COMMENT: ====================================================================================
    COMMENT: These are plain public fields. Do NOT generate getter/setter pairs for them --
    COMMENT: importFromObject() assigns them by name, and castTypes below handles conversion.

<% if (hasProperties) { -%>
<%   for (let propertyName of propertyNames) { -%>
    COMMENT: <%- model.properties[propertyName].description %>
    PUBLIC <%- propertyName %>: <%- helpers.getDataType(model.properties[propertyName]) %> = <%- helpers.getDefaultValue(model.properties[propertyName]) %>

<%   } -%>
<% } -%>
<%- partial.getIfExists(`objects/${model.name}/properties`) -%>

    COMMENT: ====================================================================================
    COMMENT: CONSTRUCTOR
    COMMENT: ====================================================================================

    CONSTRUCTOR()

        PURPOSE: Create an empty instance. Data is applied separately.

        COMMENT: The constructor takes NO arguments, deliberately.
        COMMENT:
        COMMENT: The object factory constructs the instance, assigns `core`, and only THEN
        COMMENT: calls importFromObject(). That ordering is load-bearing: importing nested
        COMMENT: objects goes through castToExpectedType() -> factory -> which needs `core`
        COMMENT: already set. A constructor that accepted and imported data would run before
        COMMENT: core exists, and nested models would be built without it.

        BEHAVIOR:
            COMMENT: Call the parent BaseObject constructor
            CALL super()
    END CONSTRUCTOR

    COMMENT: ====================================================================================
    COMMENT: ABSTRACT PROPERTY OVERRIDES
    COMMENT: ====================================================================================
    COMMENT: BaseObject declares these as abstract and throws if they are not overridden.
    COMMENT: Express them however your language does read-only overrides -- getters,
    COMMENT: properties, constant fields, whatever is idiomatic.

    GETTER objectName(): string
        PURPOSE: Identifies this object type for the wire format and for debugging
        COMMENT: This is the SCHEMA name, which may differ from the class name above.
        RETURN "<%- model.name %>"
    END GETTER

    GETTER objectType(): string
        PURPOSE: Categorises this model as an object (vs. a component or a result)
        RETURN "object"
    END GETTER

    GETTER propertyNames(): array<string>
        PURPOSE: Lists every property this model owns
        COMMENT: Drives both importFromObject() and toObject(), so this list defines
        COMMENT: exactly what is read from, and written to, the wire.
        RETURN <%- JSON.stringify(propertyNames) %>
    END GETTER

    GETTER requiredProperties(): array<string>
        PURPOSE: Lists properties that must be present for this model to be valid
<% if (hasRequiredOverride) { -%>
<%- requiredOverride -%>
<% } else { -%>
        RETURN <%- JSON.stringify(requiredParams) %>
<% } -%>
    END GETTER

    GETTER castTypes(): map<string, string>
        PURPOSE: Tells importFromObject() how to convert raw JSON values into typed models
        COMMENT: Generated from the schema. Values are SCHEMA names, because the object
        COMMENT: factory keys on schema names -- "Error", not "NgioError".
        COMMENT: "array-of-X" is a string convention: BaseObject looks for the prefix and
        COMMENT: builds each element through the factory.
<% if (Object.keys(castTypes).length === 0) { -%>
        RETURN {}
<% } else { -%>
        RETURN {
<%   const castEntries = Object.entries(castTypes); -%>
<%   castEntries.forEach(function(entry, i) { -%>
            "<%- entry[0] %>": "<%- entry[1] %>"<%- i < castEntries.length - 1 ? "," : "" %>
<%   }); -%>
        }
<% } -%>
    END GETTER

    COMMENT: ====================================================================================
    COMMENT: CUSTOM METHODS
    COMMENT: ====================================================================================
<%# Add object-specific methods using partials -%>
<%# Example: {partials_dir}/objects/Medal/methods.ejs -%>
<%- partial.getIfExists(`objects/${model.name}/methods`) -%>

END CLASS
