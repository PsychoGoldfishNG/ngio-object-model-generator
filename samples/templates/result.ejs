<%
/**
 * ====================================================================================
 * TEMPLATE: Component Result Model
 * ====================================================================================
 *
 * PURPOSE: Generates class files for component result objects.
 *
 * WHAT ARE RESULTS?: When you call a component (API method), the server responds with
 * a result object containing the data returned. For example:
 * - Medal.unlock returns: { medal_score: integer, unlocked_medals: array<Medal> }
 * - ScoreBoard.getScores returns: { scores: array<Score>, user: User }
 * - App.checkSession returns: { session: Session }
 *
 * WHY SEPARATE FROM COMPONENTS?: Components are what you SEND to the server (input),
 * Results are what you GET BACK from the server (output). They're modeled separately.
 *
 * AVAILABLE VARIABLES:
 * - model: Object containing all properties and metadata for this result
 * - model.component: The component namespace (e.g., "Medal", "App", "ScoreBoard")
 * - model.method: The method name (e.g., "unlock", "checkSession", "getScores")
 * - model.properties: Object containing all properties this result returns
 * - helpers: Your custom helper methods (from helpers.js)
 * - partial: Methods to include partial templates (partial.get, partial.getIfExists)
 * - config: Your full config object with all settings
 *
 * EJS DOCUMENTATION: https://ejs.co/
 *
 * ====================================================================================
 */

// COMMENT: Prepare data structures we'll need while generating this class
//
// Filter out BOTH 'error' and 'success'. They are declared on BaseResult/BaseObject and
// must NOT be re-declared here, nor appear in propertyNames.
//
// This matters more than it looks. propertyNames drives toObject(), so listing 'success'
// or 'error' would round-trip the server's control fields back into serialized output.
// And putting 'success' in requiredProperties makes hasValidProperties() return false for
// every freshly constructed result, because success defaults to false.
const propertyNames = Object.keys(model.properties)
    .filter(prop => prop !== 'error' && prop !== 'success');
const requiredParams = propertyNames.filter(name => model.properties[name].required);
const hasProperties = propertyNames.length > 0;

// The component path this result belongs to. Note it is the COMPONENT path -- there is
// no "Result" suffix on it -- because AppState dispatches incoming results by matching
// objectName against the component that was called.
const componentPath = `${model.component}.${model.method}`;

// castTypes is fully derivable from the schema -- never hand-maintain it.
const castTypes = helpers.getCastTypes(model.properties, propertyNames);
-%>

COMMENT: ====================================================================================
COMMENT: IMPORTS / DEPENDENCIES
COMMENT: ====================================================================================
<%# Include any imports needed for this result type. -%>
<%# Use partials to add result-specific imports. Example partial path for Medal.unlock: -%>
<%# {partials_dir}/results/Medal/unlock/imports.ejs -%>
<%- partial.getIfExists(`results/${model.component}/${model.method}/imports`) -%>

COMMENT: ====================================================================================
COMMENT: CLASS DEFINITION
COMMENT: ====================================================================================
COMMENT: Result for: <%- componentPath %>
CLASS <%- model.method %>Result
    EXTENDS: BaseResult
    NAMESPACE: [Your namespace here, e.g., io.newgrounds.models.results.<%- model.component %>]

    PURPOSE: Contains the data returned by the <%- componentPath %> API call

    COMMENT: ====================================================================================
    COMMENT: PROPERTIES
    COMMENT: ====================================================================================
    COMMENT: Plain public fields. 'success' and 'error' are NOT here -- they come from
    COMMENT: BaseResult and BaseObject respectively.

<% if (hasProperties) { -%>
<%   for (let propertyName of propertyNames) { -%>
    COMMENT: <%- model.properties[propertyName].description %>
    PUBLIC <%- propertyName %>: <%- helpers.getDataType(model.properties[propertyName]) %> = <%- helpers.getDefaultValue(model.properties[propertyName]) %>

<%   } -%>
<% } -%>
<%- partial.getIfExists(`results/${model.component}/${model.method}/properties`) -%>

    COMMENT: ====================================================================================
    COMMENT: CONSTRUCTOR
    COMMENT: ====================================================================================

    CONSTRUCTOR()

        PURPOSE: Create an empty instance. Data is applied separately.

        COMMENT: Takes NO arguments -- see object.ejs for why the factory imports
        COMMENT: data only after assigning `core`.

        BEHAVIOR:
            COMMENT: Call the parent BaseResult constructor
            CALL super()
<%- partial.getIfExists(`results/${model.component}/${model.method}/constructor`) -%>
    END CONSTRUCTOR

    COMMENT: ====================================================================================
    COMMENT: ABSTRACT PROPERTY OVERRIDES
    COMMENT: ====================================================================================
    COMMENT: BaseObject declares these as abstract and throws if they are not overridden.

    GETTER objectName(): string
        PURPOSE: Identifies which component produced this result
        COMMENT: This is the COMPONENT path, NOT the result class name. AppState routes
        COMMENT: incoming results by matching this against the component that was called,
        COMMENT: so "<%- model.method %>Result" here would silently stop those updates
        COMMENT: from ever being applied.
        RETURN "<%- componentPath %>"
    END GETTER

    GETTER objectType(): string
        PURPOSE: Categorises this model as a result (vs. an object or a component)
        RETURN "result"
    END GETTER

    GETTER propertyNames(): array<string>
        PURPOSE: Lists the data properties this result carries
        COMMENT: 'success' and 'error' are deliberately absent -- see the note at the
        COMMENT: top of this template.
        RETURN <%- JSON.stringify(propertyNames) %>
    END GETTER

    GETTER requiredProperties(): array<string>
        PURPOSE: Lists properties that must be present for this result to be valid
        COMMENT: Usually empty. A result arrives already built by the server, and a
        COMMENT: failed call legitimately carries none of its data properties -- so
        COMMENT: requiring any of them would mark ordinary error responses invalid.
        RETURN <%- JSON.stringify(requiredParams) %>
    END GETTER

    GETTER castTypes(): map<string, string>
        PURPOSE: Tells importFromObject() how to convert raw JSON into typed models
        COMMENT: Generated from the schema. Values are SCHEMA names, because the object
        COMMENT: factory keys on schema names -- "Error", not "NgioError".
<% if (Object.keys(castTypes).length === 0) { -%>
        RETURN {}
<% } else { -%>
        RETURN {
<%   const castEntries = Object.entries(castTypes); -%>
<%   castEntries.forEach(function(entry, i) { -%>
            "<%- entry[0] %>": "<%- entry[1] %>"<%- i < castEntries.length - 1 ? "," : "" %>
<%   }); -%>
        }
<% } -%>
    END GETTER

    COMMENT: ====================================================================================
    COMMENT: CUSTOM METHODS
    COMMENT: ====================================================================================
<%# Add result-specific methods using partials -%>
<%# Example: {partials_dir}/results/Medal/unlock/methods.ejs -%>
<%- partial.getIfExists(`results/${model.component}/${model.method}/methods`) -%>

END CLASS
