    <%# EJS DOCUMENTATION: https://ejs.co/ %>
    COMMENT: ====================================================================================
    COMMENT: CUSTOM METHODS FOR ScoreBoard OBJECT
    COMMENT: ====================================================================================
    
    COMMENT: Loads scores from this scoreboard with optional filtering.
    METHOD getScores(filters: Object, callback: Function, thisArg: Object)
        
        PURPOSE: Retrieves scores from this scoreboard with various filter options
        
        PARAMETERS:
            filters: Object containing optional filters:
                - user_id: Filter by specific user ID
                - user_name: Filter by username
                - user: User object (uses id property)
                - period: Time period ('D'=day, 'W'=week, 'M'=month, 'Y'=year, 'A'=all-time)
                - limit: Max scores to return (1-100, default: 10)
                - skip: Scores to skip (for pagination, default: 0)
                - social: Get only friends' scores (requires logged-in user)
                - tag: Filter by score tag - pass through BYTE-FOR-BYTE, see postScore
            callback: Function to call when the load completes, as callback(scores, error)
                      where error is null on success and scores is null on failure
            thisArg: Context to use when calling the callback
        
        WHY: Developers need flexible ways to query scoreboards - by user, time period,
             friends-only, pagination, etc.
        
        BEHAVIOR:
            COMMENT: Ensure filters is an object
            IF filters is null THEN
                SET filters TO empty object
            END IF
            
            CREATE componentParams AS empty object
            
            COMMENT: Set default period to daily
            IF filters.period is undefined or null THEN
                SET filters.period TO 'D'
            END IF
            SET componentParams.period TO filters.period
            
            COMMENT: Validate and set limit
            IF filters.limit is undefined or null THEN
                SET filters.limit TO 10
            END IF
            
            IF filters.limit < 1 THEN
                THROW error "ScoreBoard filter limit must be greater than 0"
            END IF
            
            IF filters.limit > 100 THEN
                THROW error "ScoreBoard filter limit must be less than or equal to 100"
            END IF
            
            SET componentParams.limit TO filters.limit
            
            COMMENT: Set skip for pagination
            IF filters.skip is not defined THEN
                SET filters.skip TO 0
            END IF
            SET componentParams.skip TO filters.skip
            
            COMMENT: Handle social filter (friends only)
            IF this.core is not null AND this.core.hasSession() AND filters.social is true THEN
                SET componentParams.social TO true
            END IF
            
            COMMENT: Handle tag filter
            IF filters.tag is defined THEN
                SET componentParams.tag TO filters.tag
            END IF
            
            COMMENT: Handle user filtering with strict typing
            IF filters.user_id is defined THEN
                IF filters.user_id is integer THEN
                    SET componentParams.user TO filters.user_id
                ELSE
                    THROW error "ScoreBoard filter user_id must be an integer"
                END IF
            ELSE IF filters.user_name is defined THEN
                IF filters.user_name is string THEN
                    SET componentParams.user TO filters.user_name
                ELSE
                    THROW error "ScoreBoard filter user_name must be a string"
                END IF
            ELSE IF filters.user is defined THEN
                IF filters.user is User THEN
                    SET componentParams.user TO filters.user.id
                ELSE IF filters.user has property id THEN
                    SET componentParams.user TO filters.user.id
                ELSE
                    THROW error "ScoreBoard filter user must be a User object with an id property"
                END IF
            END IF
            
            COMMENT: Add this scoreboard's ID
            SET componentParams.id TO this.id
            
            COMMENT: Execute the component via core
            IF this.core is not null THEN
                CALL this.core.callComponent("ScoreBoard.getScores", componentParams, FUNCTION onComplete(response)
                    CREATE result AS null
                    CREATE scores AS null
                    CREATE error AS null

                    COMMENT: A failed load surfaces at either of TWO levels, and both must
                    COMMENT: be checked. The gateway returns a successful RESPONSE for a
                    COMMENT: component that failed, so trusting the outer flag alone treats
                    COMMENT: every rejected request as a success - and then reads scores off
                    COMMENT: a result that was never built.
                    IF response is null OR response.success is not true THEN
                        IF response is not null AND response.error is not null THEN
                            SET error TO response.error
                        ELSE
                            SET error TO a newly created error
                        END IF
                    ELSE
                        SET result TO response.getResult()

                        IF result is null THEN
                            SET error TO a newly created "invalid response" error
                        ELSE IF result.success is not true THEN
                            IF result.error is not null THEN
                                SET error TO result.error
                            ELSE
                                SET error TO a newly created error
                            END IF
                        ELSE
                            SET scores TO result.scores
                        END IF
                    END IF

                    IF callback is not null THEN
                        COMMENT: (scores, error) - matching every other wrapper callback.
                        COMMENT: scores is null on failure; `error` is the success signal.
                        CALL callback WITH context thisArg
                            PASSING scores, error
                    END IF
                END FUNCTION, thisArg)
            END IF
    END METHOD

    COMMENT: Posts a score to this scoreboard.
    METHOD postScore(value: Integer, tag: String, callback: Function, thisArg: Object)
        
        PURPOSE: Submits a score to this scoreboard for the current user
        
        PARAMETERS:
            value: The score value to post
            tag: Optional tag to associate with the score (e.g., level name, difficulty)
            callback: Function to call when posting completes, as callback(score, error)
                      where error is null on success and score is null on failure
            thisArg: Context to use when calling the callback

        WHY: This is how users submit their scores to leaderboards

        TAG HANDLING - PASS IT THROUGH UNTOUCHED:
            A tag is a LOOKUP KEY, not a display string. It is attached here and later
            handed back to getScores to filter on, so the two must be the same bytes.

            Do NOT validate, reject, normalize, case-fold, trim or transform it. Send
            exactly the string the developer supplied. Games published over many years
            already use whatever they use, and a library that "cleaned up" a tag would
            stop those games from matching their own existing scores. Nothing else in
            the stack enforces a format either, so a port that added validation would be
            silently incompatible with every other port.

            The complete rule is the one below: omit the parameter when the string is
            empty. Nothing more.

            (Developer-facing guidance - keep tags to [A-Za-z0-9_.:-] - belongs in your
            port's DOCUMENTATION, never in its code. Matching is case-insensitive, and
            outside ASCII it depends on Unicode normalization and storage collation, so
            non-ASCII tags can silently fail to match. That is advice for the game
            author to follow, not a rule for the library to impose.)

        BEHAVIOR:
            COMMENT: Build the component properties
            CREATE componentParams WITH {
                id: this.id,
                value: value
            }
            
            COMMENT: Add tag if provided
            IF tag is a non-empty string THEN
                SET componentParams.tag TO tag
            END IF
            
            COMMENT: Execute the component via core
            IF this.core is not null THEN
                CALL this.core.callComponent("ScoreBoard.postScore", componentParams, FUNCTION onComplete(response)
                    CREATE result AS null
                    CREATE score AS null
                    CREATE error AS null

                    COMMENT: Same two-level check as getScores above.
                    IF response is null OR response.success is not true THEN
                        IF response is not null AND response.error is not null THEN
                            SET error TO response.error
                        ELSE
                            SET error TO a newly created error
                        END IF
                    ELSE
                        SET result TO response.getResult()

                        IF result is null THEN
                            SET error TO a newly created "invalid response" error
                        ELSE IF result.success is not true THEN
                            IF result.error is not null THEN
                                SET error TO result.error
                            ELSE
                                SET error TO a newly created error
                            END IF
                        ELSE
                            SET score TO result.score
                        END IF
                    END IF

                    IF callback is not null THEN
                        COMMENT: (score, error) - score is null on failure.
                        CALL callback WITH context thisArg
                            PASSING score, error
                    END IF
                END FUNCTION, thisArg)
            END IF
    END METHOD

    COMMENT: Returns a string representation of this scoreboard.
    METHOD toString(): String
        
        PURPOSE: Provides human-readable scoreboard representation
        
        RETURNS: ScoreBoard description formatted as "ScoreBoard #[id] - [name]"
        
        WHY: Allows convenient string conversion for logging, debugging, and display
        
        BEHAVIOR:
            COMMENT: Construct string representation with ID and name
            CREATE description AS "ScoreBoard #"
            IF this.id is not null THEN
                SET description TO description + this.id
            ELSE
                SET description TO description + "null"
            END IF
            SET description TO description + " - "
            IF this.name is not null THEN
                SET description TO description + this.name
            ELSE
                SET description TO description + "null"
            END IF
            RETURN description
    END METHOD

