    <%# EJS DOCUMENTATION: https://ejs.co/ %>
    COMMENT: ====================================================================================
    COMMENT: CUSTOM METHOD: unlock
    COMMENT: ====================================================================================
    
    COMMENT: Unlocks this medal for the current user.
    METHOD unlock(callback: Function, thisArg: Object)

        PURPOSE: Unlocks this medal and notifies the callback when complete

        PARAMETERS:
            callback: Function to call when the unlock completes, as callback(medal, error)
                      where error is null on success. The updated point total is available
                      from the app state, which is refreshed from this same result.
            thisArg: Context to use when calling the callback

        BEHAVIOR:
            COMMENT: Refuse this on a medal loaded from another app. Medal.unlock takes
            COMMENT: no app_id, so it would send this medal's id against YOUR app and
            COMMENT: come back as error 202 - a confusing failure with no obvious cause.
            COMMENT: See BaseObject.assertNotForeign.
            CALL this.assertNotForeign("unlock()", "The gateway would reject this medal id against this app.")

            COMMENT: Call the Medal.unlock component via core
            IF this.core is not null THEN
                CALL this.core.callComponent("Medal.unlock", { id: this.id }, FUNCTION onComplete(response)
                    CREATE result AS null
                    CREATE error AS null

                    COMMENT: A rejected unlock surfaces at either of TWO levels, and both
                    COMMENT: must be checked. The gateway returns a successful RESPONSE for a
                    COMMENT: component that failed, so trusting the outer flag alone reports
                    COMMENT: every rejected unlock as a success.
                    IF response is null OR response.success is not true THEN
                        COMMENT: Level 1 - the request itself failed
                        IF response is not null AND response.error is not null THEN
                            SET error TO response.error
                        ELSE
                            SET error TO a newly created error
                        END IF
                    ELSE
                        SET result TO response.getResult()

                        COMMENT: Level 2 - the request worked, the component did not
                        IF result is null THEN
                            SET error TO a newly created "invalid response" error
                        ELSE IF result.success is not true THEN
                            IF result.error is not null THEN
                                SET error TO result.error
                            ELSE
                                SET error TO a newly created error
                            END IF
                        END IF
                    END IF

                    COMMENT: Only mark this unlocked if the server actually accepted it.
                    COMMENT: Setting it on any response leaves the medal permanently showing
                    COMMENT: as earned, and nothing later corrects it - a rejected unlock
                    COMMENT: returns no medal object to overwrite the flag.
                    IF error is null THEN
                        SET this.unlocked TO true
                    END IF

                    IF callback is defined THEN
                        COMMENT: (medal, error) - matching every other wrapper callback.
                        COMMENT: The medal is returned either way, so `error` is the only
                        COMMENT: reliable success signal.
                        CALL callback WITH context thisArg
                            PASSING this, error
                    END IF
                END FUNCTION, thisArg)
            END IF
    END METHOD
    
    COMMENT: Returns a string representation of this medal.
    METHOD toString(): String
        
        PURPOSE: Provides human-readable medal representation
        
        RETURNS: Medal description formatted as "Medal #[id] - [name]"
        
        WHY: Allows convenient string conversion for logging, debugging, and display
        
        BEHAVIOR:
            COMMENT: Construct string representation with ID and name
            CREATE description AS "Medal #"
            IF this.id is not null THEN
                SET description TO description + this.id
            ELSE
                SET description TO description + "null"
            END IF
            SET description TO description + " - "
            IF this.name is not null THEN
                SET description TO description + this.name
            ELSE
                SET description TO description + "null"
            END IF
            RETURN description
    END METHOD
    
    COMMENT: ====================================================================================
    COMMENT: SESSION MANAGEMENT METHOD
    COMMENT: ====================================================================================
    
    COMMENT: Clears session-specific data to return the medal to its unauthenticated state.
    METHOD clearSessionData()
        
        PURPOSE: Resets the medal to reflect only server-defined state, not user-specific unlock status
        
        WHY: Called by AppState.onSessionCleared() when the user's session expires or is cleared
        
        BEHAVIOR:
            SET this.unlocked TO false
    END METHOD
