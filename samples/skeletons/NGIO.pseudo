    ====================
    PRIVATE STATIC METHODS
    ====================

    FUNCTION startKeepAliveTimer()
        
        PURPOSE: Sets up an automatic timer that pings the server periodically.
        NOTE: Implementation varies by platform. See IMPLEMENTATION-GUIDE.txt for timer patterns.
        
        BEHAVIOR:
            IF keepAliveTimer is not null THEN
                RETURN
            END IF

            COMMENT: Set up repeating timer that calls keepAlive() every KEEP_ALIVE_TIME seconds
            COMMENT: This prevents active user sessions from expiring due to inactivity
            IF platform_supports_timers THEN
                SET keepAliveTimer TO START_REPEATING_TIMER(keepAlive, KEEP_ALIVE_TIME)
            END IF
    END FUNCTION

    FUNCTION executeGatewayDateTime(callback: function, thisArg: any, returnType: string)

        PURPOSE: Shared body for loadGatewayDateTime / loadGatewayTimestamp / loadGatewayDate.
        WHY: Both send the same component and differ only in what they hand back.

        PARAMETERS:
            callback: Function to call with (value, error)
            thisArg: (optional, default: null) Context to use when calling the callback
            returnType: One of "datetime", "timestamp", "date"

        BEHAVIOR:
            IF core is null THEN
                THROW error "Core not initialized"
            END IF

            COMMENT: CASING: the component class is Gateway.getDatetime - lowercase 't'.
            COMMENT: The factory lowercases before matching, so the string passed here is
            COMMENT: forgiving, but a direct `new ...Gateway.getDateTime()` is not: that
            COMMENT: class does not exist and will not compile. Always go through the
            COMMENT: factory, and spell the class name getDatetime if you must name it.
            CREATE component AS CALL ObjectFactory.CreateComponent("Gateway", "getDatetime", null, core)
            IF component is null THEN
                THROW error "Could not create Gateway.getDatetime component"
            END IF

            CALL core.executeComponent(component,
                FUNCTION onComplete(response)
                    IF response is null THEN
                        IF callback is not null THEN
                            CALL callback WITH context thisArg PASSING null, null
                        END IF
                        RETURN
                    END IF

                    COMMENT: Resolve the error from BOTH levels. The gateway returns a
                    COMMENT: successful RESPONSE carrying a component result that failed,
                    COMMENT: so the outer flag alone is not a success signal.
                    CREATE error AS response.error

                    CREATE result AS null
                    IF response.success equals true THEN
                        SET result TO response.getResult()
                    END IF

                    IF error is null AND result is not null AND result.error is not null THEN
                        SET error TO result.error
                    END IF

                    IF callback is null THEN
                        RETURN
                    END IF

                    IF error is not null OR result is null THEN
                        CALL callback WITH context thisArg PASSING null, error
                    ELSE IF returnType equals "datetime" THEN
                        CALL callback WITH context thisArg PASSING result.datetime, error
                    ELSE IF returnType equals "date" THEN
                        COMMENT: Server timestamp is in SECONDS. Scale it to whatever unit
                        COMMENT: your platform's date type expects - milliseconds in most.
                        CALL callback WITH context thisArg PASSING NEW_DATE_FROM_SECONDS(result.timestamp), error
                    ELSE
                        CALL callback WITH context thisArg PASSING result.timestamp, error
                    END IF
                END FUNCTION
            )
    END FUNCTION

END CLASS
